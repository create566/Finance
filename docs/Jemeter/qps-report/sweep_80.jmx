<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ww_finance 接口性能测试（QPS）">
      <stringProp name="TestPlan.comments">ww_finance 实训项目 · 接口 QPS 压测计划

【设计要点】
1) token 自动获取：setUp 线程组先登录 3 个身份（管理员/借款人/投资人），
   用 JSON 提取器取出 data，再用 JSR223 把它们 put 进【全局属性】。
   压测线程组通过 ${__P(adminToken)} / ${__P(userToken)} / ${__P(investorToken)} 读取，
   所以全程不需要手工粘贴 token。
2) 压测主体【只选读接口】：列表 / 详情 / 推荐 / 消息 / 账户 / 合同 / 流水。
   刻意不压 充值、提现、还款、投标、放款 —— 这些接口在银行侧没有幂等去重，
   压测会产生重复入账的脏数据（详见 docs/遗留问题与整改清单.md）。
3) 场景分两组：
   · 混合读接口 —— 模拟真实用户浏览行为（主场景，看 QPS / 响应时间分位）
   · 登录接口 —— 单独看登录链路（含 Redis 写入 + JWT 签发）的吞吐

【命令行跑法（推荐，不占 GUI 资源）】
  jmeter -n -t ww_finance_benchmark.jmx -l result.jtl -e -o report
  # 结果：result.jtl（原始）+ report/index.html（HTML 报告，含 TPS/分位图）

【调参】改下面的 threads / ramp / duration 三个变量即可：
  threads   并发线程数（默认 20）
  ramp      多少秒内把线程拉起（默认 10）
  duration  压测持续秒数（默认 120）</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
        <collectionProp name="Arguments.arguments">
          <elementProp name="host" elementType="Argument">
            <stringProp name="Argument.name">host</stringProp>
            <stringProp name="Argument.value">127.0.0.1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">8990</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="adminUsername" elementType="Argument">
            <stringProp name="Argument.name">adminUsername</stringProp>
            <stringProp name="Argument.value">admin</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="adminPassword" elementType="Argument">
            <stringProp name="Argument.name">adminPassword</stringProp>
            <stringProp name="Argument.value">123456</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="userMobile" elementType="Argument">
            <stringProp name="Argument.name">userMobile</stringProp>
            <stringProp name="Argument.value">18538313405</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="userPassword" elementType="Argument">
            <stringProp name="Argument.name">userPassword</stringProp>
            <stringProp name="Argument.value">123456</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="investorMobile" elementType="Argument">
            <stringProp name="Argument.name">investorMobile</stringProp>
            <stringProp name="Argument.value">14725836945</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="investorPassword" elementType="Argument">
            <stringProp name="Argument.name">investorPassword</stringProp>
            <stringProp name="Argument.value">123456</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="lendId" elementType="Argument">
            <stringProp name="Argument.name">lendId</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">80</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ramp" elementType="Argument">
            <stringProp name="Argument.name">ramp</stringProp>
            <stringProp name="Argument.value">10</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="duration" elementType="Argument">
            <stringProp name="Argument.name">duration</stringProp>
            <stringProp name="Argument.value">45</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp 登录（自动取 token）">
