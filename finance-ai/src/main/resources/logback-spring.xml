<?xml version="1.0" encoding="UTF-8"?>
<!--
  finance-ai 服务（8081）日志落盘配置
  - CONSOLE：照常输出到终端
  - FILE：按天 + 单文件 50MB 滚动写入 logs/ai/finance-ai.log
  - 日志根目录默认 <项目根>/logs，可用环境变量 LOG_HOME 覆盖
-->
<configuration>

    <!-- 日志根目录默认写项目绝对路径：IDEA 运行配置的工作目录是项目根，而 mvn spring-boot:run
         的工作目录是模块目录（finance-ai/），相对路径会让日志目录随启动方式漂移。
         换目录/换机器时设置环境变量 LOG_HOME 即可，不必改本文件。 -->
    <property name="LOG_HOME" value="${LOG_HOME:-D:/桌面/实训/demo/logs}"/>
    <property name="MODULE" value="ai"/>
    <property name="APP_NAME" value="finance-ai"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${MODULE}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${MODULE}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 想看 ReAct / RAG 细节把下面这行改成 DEBUG -->
    <logger name="com.kzip.app" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
